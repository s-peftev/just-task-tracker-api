@using JustTaskTracker.WebUI.Domain.Auth
@using JustTaskTracker.WebUI.Domain.Boards
@using JustTaskTracker.WebUI.Domain.Boards.Enums
@using JustTaskTracker.WebUI.Components.Shared
@using JustTaskTracker.WebUI.Infrastructure
@using JustTaskTracker.WebUI.Services.Abstractions.Boards
@using JustTaskTracker.WebUI.Services.Exceptions
@inject IDialogService DialogService
@inject IBoardApiService BoardApiService
@inject IBoardDetailsStore BoardDetailsStore
@inject IBoardTaskStore BoardTaskStore
@inject ISnackbar Snackbar

<div role="button"
     tabindex="0"
     class="board-task-card @(CanDrag ? "board-task-card--draggable" : null) @(IsAssignedToCurrentUser ? "board-task-card--assigned-to-me" : null) @(Task.IsDone ? "board-task-card--done" : null)"
     @onpointerdown="OnPointerDown"
     @onpointerup="OnPointerUp"
     @onkeydown="OnCardKeyDownAsync">
    <div class="board-task-card__header">
        <span class="board-task-card__type board-task-card__type--@TypeModifierClass">
            [@TypeLabel]
        </span>

        @if (CanToggleCompletion)
        {
            <button type="button"
                    class="board-task-card__status @(Task.IsDone ? "board-task-card__status--done" : null) board-task-card__status--toggle"
                    disabled="@_isSavingCompletion"
                    aria-label="@(Task.IsDone ? "Mark as not done" : "Mark as done")"
                    @onpointerdown:stopPropagation="true"
                    @onpointerup:stopPropagation="true"
                    @onclick:stopPropagation="true"
                    @onclick="OnToggleCompletionAsync">
                @if (Task.IsDone)
                {
                    <span class="board-task-card__status-label">Done</span>
                    <svg class="board-task-card__status-icon"
                         viewBox="0 0 24 24"
                         aria-hidden="true"
                         focusable="false">
                        <rect x="3"
                              y="3"
                              width="18"
                              height="18"
                              rx="4"
                              fill="currentColor" />
                        <path d="M8 12.5 11 15.5 16.5 9"
                              stroke="var(--jtt-surface-task-card)"
                              stroke-width="2.25"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              fill="none" />
                    </svg>
                }
                else
                {
                    <svg class="board-task-card__status-icon"
                         viewBox="0 0 24 24"
                         aria-hidden="true"
                         focusable="false">
                        <rect x="3.5"
                              y="3.5"
                              width="17"
                              height="17"
                              rx="3.5"
                              stroke="currentColor"
                              stroke-width="1.75"
                              fill="none" />
                    </svg>
                }
            </button>
        }
        else if (Task.IsDone)
        {
            <span class="board-task-card__status board-task-card__status--done"
                  aria-label="Done">
                <span class="board-task-card__status-label">Done</span>
                <svg class="board-task-card__status-icon"
                     viewBox="0 0 24 24"
                     aria-hidden="true"
                     focusable="false">
                    <rect x="3"
                          y="3"
                          width="18"
                          height="18"
                          rx="4"
                          fill="currentColor" />
                    <path d="M8 12.5 11 15.5 16.5 9"
                          stroke="var(--jtt-surface-task-card)"
                          stroke-width="2.25"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          fill="none" />
                </svg>
            </span>
        }
    </div>

    <div class="board-task-card__body">
        <span class="board-task-card__title">@Task.Title</span>
    </div>

    <div class="board-task-card__meta">
        <span class="board-task-card__assignee @(Task.Assignee is null ? "board-task-card__assignee--empty" : null)">
            @if (Task.Assignee is { } assignee)
            {
                <UserAvatarPlaceholder Size="1.125rem"
                                       DisplayName="@assignee.DisplayName"
                                       Email="@assignee.Email"
                                       ProfilePhotoUrl="@assignee.ProfilePhotoUrl"
                                       Class="board-task-card__assignee-avatar" />
                <span class="board-task-card__assignee-name">@GetAssigneeDisplayName(assignee)</span>
            }
            else
            {
                <svg class="board-task-card__assignee-empty-icon"
                     viewBox="0 0 24 24"
                     aria-hidden="true"
                     focusable="false">
                    <circle cx="12"
                            cy="8"
                            r="4"
                            stroke="currentColor"
                            stroke-width="2"
                            fill="none" />
                    <path d="M4 20v-1a5 5 0 0 1 5-5h6a5 5 0 0 1 5 5v1"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          fill="none" />
                </svg>
                <span class="board-task-card__assignee-name">Unassigned</span>
            }
        </span>

        @if (HasOpenTimebox)
        {
            <span class="board-task-card__estimate board-task-card__estimate--open"
                  title="Unlimited timebox"
                  aria-label="Unlimited timebox">
                [
                <svg class="board-task-card__estimate-infinity"
                     viewBox="0 0 24 24"
                     aria-hidden="true"
                     focusable="false">
                    <path d="M18.178 8c5.096 0 5.096 8 0 8-5.095 0-7.133-8-12.739-8-4.585 0-4.585 8 0 8 5.606 0 7.644-8 12.74-8z"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.25"
                          stroke-linecap="round"
                          stroke-linejoin="round" />
                </svg>
                ]
            </span>
        }
        else if (EstimateLabel is not null)
        {
            <span class="board-task-card__estimate">@EstimateLabel</span>
        }
    </div>

    @if (HasFooter)
    {
        <div class="board-task-card__footer" aria-hidden="true">
            @if (Task.CommentsCount > 0)
            {
                <span class="board-task-card__stat">
                    <svg class="board-task-card__stat-icon"
                         viewBox="0 0 24 24"
                         aria-hidden="true"
                         focusable="false">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              fill="none" />
                        <path d="M8 10h8"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round" />
                        <path d="M8 14h5"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round" />
                    </svg>
                    <span class="board-task-card__stat-value">@Task.CommentsCount</span>
                </span>
            }

            @if (Task.AttachmentsCount > 0)
            {
                <span class="board-task-card__stat">
                    <svg class="board-task-card__stat-icon"
                         viewBox="0 0 24 24"
                         aria-hidden="true"
                         focusable="false">
                        <path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57a4 4 0 1 1 5.66 5.66l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              fill="none" />
                    </svg>
                    <span class="board-task-card__stat-value">@Task.AttachmentsCount</span>
                </span>
            }
        </div>
    }
</div>

@code {
    private const double ClickMoveThresholdPx = 5;

    [Parameter, EditorRequired]
    public BoardTaskPreviewDto Task { get; set; } = default!;

    [Parameter, EditorRequired]
    public Guid ColumnId { get; set; }

    [Parameter]
    public bool CanDrag { get; set; }

    [Parameter]
    public bool IsAssignedToCurrentUser { get; set; }

    [Parameter]
    public bool CanToggleCompletion { get; set; }

    [Parameter]
    public EventCallback<BoardTaskPreviewDto> OnTaskClick { get; set; }

    private bool HasFooter =>
        Task.CommentsCount > 0 || Task.AttachmentsCount > 0;

    private string TypeLabel => Task.Type switch
    {
        BoardTaskType.Bug => "Bug",
        BoardTaskType.Spike => "Spike",
        _ => "Story",
    };

    private string TypeModifierClass => Task.Type switch
    {
        BoardTaskType.Bug => "bug",
        BoardTaskType.Spike => "spike",
        _ => "story",
    };

    private bool HasOpenTimebox =>
        Task.Type == BoardTaskType.Spike && Task.TimeboxHours is null;

    private string? EstimateLabel => Task.Type switch
    {
        BoardTaskType.Story => $"[ {Task.StoryPoints ?? 0} SP ]",
        BoardTaskType.Spike when Task.TimeboxHours is { } hours => $"[ {hours}h ]",
        _ => null,
    };

    private bool _isSavingCompletion;
    private double? _pointerDownX;
    private double? _pointerDownY;

    private static string GetAssigneeDisplayName(UserDto assignee) =>
        string.IsNullOrWhiteSpace(assignee.DisplayName) ? assignee.Email : assignee.DisplayName;

    private async Task OnToggleCompletionAsync()
    {
        if (!CanToggleCompletion || _isSavingCompletion)
            return;

        if (BoardDetailsStore.BoardId is not { } boardId)
            return;

        var nextIsDone = !Task.IsDone;
        var title = nextIsDone ? "Mark task as done" : "Mark task as not done";
        var message = nextIsDone
            ? "Mark this task as done?"
            : "Mark this task as not done?";
        var confirmLabel = nextIsDone ? "Mark done" : "Mark not done";

        var dialog = await DialogService.ShowConfirmResourceAsync(
            title,
            message,
            confirmLabel: confirmLabel,
            submitButtonClass: "btn-dialog-warning btn-dialog-action");

        var result = await dialog.Result;

        if (result is not { Canceled: false, Data: true })
            return;

        _isSavingCompletion = true;

        try
        {
            await BoardApiService.UpdateBoardTaskCompletionAsync(
                boardId,
                ColumnId,
                Task.Id,
                nextIsDone);

            BoardDetailsStore.UpdateTaskCompletion(Task.Id, nextIsDone);

            if (BoardTaskStore.TaskId == Task.Id)
            {
                BoardTaskStore.UpdateTaskCompletion(
                    nextIsDone,
                    nextIsDone ? DateTime.UtcNow : null);
            }

            Snackbar.Add(
                nextIsDone ? "Task marked as done." : "Task marked as not done.",
                Severity.Success);
        }
        catch (ApiServiceException ex)
        {
            Snackbar.ShowApiError(ex);
        }
        finally
        {
            _isSavingCompletion = false;
        }
    }

    private void OnPointerDown(PointerEventArgs e)
    {
        _pointerDownX = e.ClientX;
        _pointerDownY = e.ClientY;
    }

    private async Task OnCardKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key is not ("Enter" or " "))
            return;

        await OnTaskClick.InvokeAsync(Task);
    }

    private async Task OnPointerUp(PointerEventArgs e)
    {
        if (_pointerDownX is not { } startX || _pointerDownY is not { } startY)
            return;

        _pointerDownX = null;
        _pointerDownY = null;

        var movedX = Math.Abs(e.ClientX - startX);
        var movedY = Math.Abs(e.ClientY - startY);

        if (movedX > ClickMoveThresholdPx || movedY > ClickMoveThresholdPx)
            return;

        await OnTaskClick.InvokeAsync(Task);
    }
}
