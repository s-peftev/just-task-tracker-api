@page "/boards/{BoardId:guid}/calls/{CallId:guid}"
@attribute [Authorize]
@implements IAsyncDisposable
@using JustTaskTracker.WebUI.Domain.Boards
@using JustTaskTracker.WebUI.Domain.Boards.Authorization
@using JustTaskTracker.WebUI.Domain.Boards.Notifications.BoardActions
@using JustTaskTracker.WebUI.Domain.Boards.Notifications.BoardActions.Payloads
@using JustTaskTracker.WebUI.Domain.Calls
@using JustTaskTracker.WebUI.Services.Abstractions.Auth
@using JustTaskTracker.WebUI.Services.Abstractions.Boards
@using JustTaskTracker.WebUI.Services.Abstractions.Calls
@using JustTaskTracker.WebUI.Services.Abstractions.Hubs
@using JustTaskTracker.WebUI.Services.Exceptions
@inject ICallSessionStore CallSessionStore
@inject ICallsInteropService CallsInteropService
@inject ICallsApiService CallsApiService
@inject IBoardActionsHubService ActionsHubService
@inject IBoardDetailsStore BoardDetailsStore
@inject IProfileStore ProfileStore
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Call — JustTaskTracker</PageTitle>

<div class="call-page">
    @if (_isJoining)
    {
        <div class="page-state page-state--stacked">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        </div>
    }
    else if (_joinError is { } error)
    {
        <div class="page-state page-state--stacked">
            <MudAlert Severity="Severity.Error">@error</MudAlert>
            <button type="button" class="btn-noir" @onclick="GoBackToBoard">
                <span>Back to board</span>
            </button>
        </div>
    }
    else
    {
        <div class="call-page__body @(IsPresentationActive ? "call-page__body--presenting" : null)">
            @if (IsPresentationActive)
            {
                <div class="call-page__stage">
                    @if (IsLocalUserPresenting)
                    {
                        <div class="call-page__stage-placeholder">
                            <span>You are presenting your screen</span>
                        </div>
                    }
                    else
                    {
                        <CallStageView OnReady="OnStageElementReadyAsync" />
                    }
                </div>
            }

            <div class="call-page__grid @(IsPresentationActive ? "call-page__grid--filmstrip" : null)" style="--call-grid-columns: @GridColumns;">
                @foreach (var tile in _tiles)
                {
                    var identity = GetTileIdentity(tile);

                    <CallGridTile @key="tile.TileId"
                                  TileId="@tile.TileId"
                                  IsLocal="@tile.IsLocal"
                                  HasVideo="@tile.HasVideo"
                                  DisplayName="@identity.DisplayName"
                                  Email="@identity.Email"
                                  ProfilePhotoUrl="@identity.ProfilePhotoUrl"
                                  OnReady="OnTileElementReadyAsync" />
                }
            </div>

            @if (_isMeetBoardOpen)
            {
                <CallMeetBoardPanel BoardId="BoardId"
                                    Title="@GetCallTitle()"
                                    Topic="@GetCallTopic()"
                                    Tasks="_linkedTasks"
                                    Columns="@(BoardDetailsStore.Board?.Columns ?? [])"
                                    IsLoading="_isLoadingLinkedTasks"
                                    OnClose="CloseMeetBoard"
                                    OnTaskChanged="OnLinkedTaskChanged" />
            }
        </div>

        <div class="call-page__controls">
            <button type="button"
                    class="btn-glass call-page__control-btn @(_micOn ? null : "call-page__control-btn--off")"
                    aria-label="@(_micOn ? "Mute microphone" : "Unmute microphone")"
                    aria-pressed="@(!_micOn)"
                    title="@(_micOn ? "Mute" : "Unmute")"
                    @onclick="ToggleMicAsync">
                @if (_micOn)
                {
                    <svg class="call-page__control-icon"
                         viewBox="0 0 24 24"
                         aria-hidden="true"
                         focusable="false">
                        <path fill="none"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M12 19v3M8 23h8M19 10v1a7 7 0 0 1-14 0v-1M12 15a3 3 0 0 0 3-3V6a3 3 0 1 0-6 0v6a3 3 0 0 0 3 3z" />
                    </svg>
                }
                else
                {
                    <svg class="call-page__control-icon"
                         viewBox="0 0 24 24"
                         aria-hidden="true"
                         focusable="false">
                        <path fill="none"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M12 19v3M8 23h8M1 1l22 22M9 9v3a3 3 0 0 0 5.12 2.12M15 9.88V6a3 3 0 0 0-5.12-2.12M19 10v1a7 7 0 0 1-2.16 4.56" />
                    </svg>
                }
            </button>
            <button type="button"
                    class="btn-glass call-page__control-btn @(_cameraOn ? null : "call-page__control-btn--off")"
                    aria-label="@(_cameraOn ? "Stop video" : "Start video")"
                    aria-pressed="@(!_cameraOn)"
                    title="@(_cameraOn ? "Stop video" : "Start video")"
                    @onclick="ToggleCameraAsync">
                @if (_cameraOn)
                {
                    <svg class="call-page__control-icon"
                         viewBox="0 0 24 24"
                         aria-hidden="true"
                         focusable="false">
                        <path fill="none"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M23 7l-7 5 7 5V7z" />
                        <rect fill="none"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              x="1"
                              y="5"
                              width="15"
                              height="14"
                              rx="2"
                              ry="2" />
                    </svg>
                }
                else
                {
                    <svg class="call-page__control-icon"
                         viewBox="0 0 24 24"
                         aria-hidden="true"
                         focusable="false">
                        <path fill="none"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M16 16v1a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h2M22 7l-7 5 7 5V7z" />
                        <line stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"
                              x1="1"
                              y1="1"
                              x2="23"
                              y2="23" />
                    </svg>
                }
            </button>
            <button type="button"
                    class="btn-glass call-page__control-btn @(IsLocalUserPresenting ? "call-page__control-btn--active" : null)"
                    aria-label="@(IsLocalUserPresenting ? "Stop sharing your screen" : "Share your screen")"
                    aria-pressed="@IsLocalUserPresenting"
                    disabled="@(_currentPresenterUserId.HasValue && !IsLocalUserPresenting)"
                    title="@GetScreenShareTitle()"
                    @onclick="ToggleScreenShareAsync">
                @if (IsLocalUserPresenting)
                {
                    <svg class="call-page__control-icon"
                         viewBox="0 0 24 24"
                         aria-hidden="true"
                         focusable="false">
                        <rect fill="none"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              x="2"
                              y="4"
                              width="20"
                              height="14"
                              rx="2"
                              ry="2" />
                        <line stroke="currentColor" stroke-width="2" stroke-linecap="round" x1="8" y1="21" x2="16" y2="21" />
                        <path fill="none"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M12 15V8m-3 3 3-3 3 3" />
                    </svg>
                }
                else
                {
                    <svg class="call-page__control-icon"
                         viewBox="0 0 24 24"
                         aria-hidden="true"
                         focusable="false">
                        <rect fill="none"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              x="2"
                              y="4"
                              width="20"
                              height="14"
                              rx="2"
                              ry="2" />
                        <line stroke="currentColor" stroke-width="2" stroke-linecap="round" x1="8" y1="21" x2="16" y2="21" />
                        <path fill="none"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M12 15V8m-3 3 3-3 3 3" />
                        <line stroke="currentColor" stroke-width="2" stroke-linecap="round" x1="1" y1="1" x2="23" y2="23" />
                    </svg>
                }
            </button>
            <button type="button"
                    class="btn-glass call-page__control-btn @(_isMeetBoardOpen ? "call-page__control-btn--active" : null)"
                    aria-label="@(_isMeetBoardOpen ? "Close meeting board" : "Open meeting board")"
                    aria-pressed="@_isMeetBoardOpen"
                    title="Meet board"
                    @onclick="ToggleMeetBoard">
                <svg class="call-page__control-icon"
                     viewBox="0 0 24 24"
                     aria-hidden="true"
                     focusable="false">
                    <path fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2" />
                    <rect fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          x="9"
                          y="3"
                          width="6"
                          height="4"
                          rx="1"
                          ry="1" />
                    <line stroke="currentColor" stroke-width="2" stroke-linecap="round" x1="8" y1="11" x2="16" y2="11" />
                    <line stroke="currentColor" stroke-width="2" stroke-linecap="round" x1="8" y1="15" x2="16" y2="15" />
                    <line stroke="currentColor" stroke-width="2" stroke-linecap="round" x1="8" y1="19" x2="12" y2="19" />
                </svg>
            </button>
            <button type="button"
                    class="btn-glass call-page__control-btn call-page__leave-btn"
                    aria-label="Leave call"
                    title="Leave"
                    @onclick="LeaveAsync">
                <svg class="call-page__control-icon"
                     viewBox="0 0 24 24"
                     aria-hidden="true"
                     focusable="false">
                    <path fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9" />
                </svg>
            </button>
            @if (_canEndCall)
            {
                <button type="button"
                        class="btn-glass call-page__control-btn call-page__end-btn"
                        aria-label="End call for everyone"
                        title="End call"
                        @onclick="EndCallAsync">
                    <svg class="call-page__control-icon"
                         viewBox="0 0 24 24"
                         aria-hidden="true"
                         focusable="false">
                        <path fill="none"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
                        <line stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"
                              x1="18"
                              y1="6"
                              x2="6"
                              y2="18" />
                    </svg>
                </button>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid BoardId { get; set; }

    [Parameter]
    public Guid CallId { get; set; }

    private record CallTile(string TileId, bool IsLocal, bool HasVideo);

    // Zoom-like layout: as few columns as possible while fitting everyone, so 1-2
    // participants fill nearly the whole area and the grid subdivides as more join.
    // While someone is presenting, the grid becomes a single-column filmstrip instead
    // (see call-page__grid--filmstrip) -- the big stage takes the rest of the space.
    private int GridColumns => IsPresentationActive
        ? 1
        : (_tiles.Count <= 1 ? 1 : (int)Math.Ceiling(Math.Sqrt(_tiles.Count)));

    private bool IsPresentationActive => _currentPresenterUserId.HasValue;

    private bool IsLocalUserPresenting =>
        _currentPresenterUserId.HasValue
        && ProfileStore.Profile is { } profile
        && _currentPresenterUserId == profile.Id;

    private bool _isJoining = true;
    private string? _joinError;
    private bool _micOn = true;
    private bool _cameraOn;
    private bool _canEndCall;
    private Guid? _currentPresenterUserId;
    private bool _hasLeft;
    private bool _joinedBoardGroup;
    private bool _isMeetBoardOpen;
    private bool _isLoadingLinkedTasks;
    private readonly List<CallTile> _tiles = [];
    private Dictionary<string, CallParticipantDto> _participantsByAcsId = [];
    private IReadOnlyList<BoardTaskDetailsDto> _linkedTasks = [];
    private DotNetObjectReference<CallPage>? _selfRef;

    protected override async Task OnInitializedAsync()
    {
        // BoardPage owns its own join/leave of this same group and is disposed when navigating here,
        // so this page must hold its own membership for as long as it's the one showing live call state.
        await ActionsHubService.JoinBoardAsync(BoardId);
        _joinedBoardGroup = true;

        CallSessionStore.CallSessionClosed += OnCallSessionClosed;
        CallSessionStore.CallParticipantsChanged += OnCallParticipantsChanged;
        CallSessionStore.CallPresenterChanged += OnCallPresenterChanged;
        ActionsHubService.BoardActionReceived += OnBoardActionReceived;

        // Both stores are read below assuming BoardPage already populated them -- true when
        // navigating here from the board, false on a direct link/hard refresh. Load them ourselves
        // so this page works the same either way.
        await Task.WhenAll(
            BoardDetailsStore.LoadAsync(BoardId),
            CallSessionStore.EnsureActiveCallsLoadedAsync(BoardId));

        var activeCall = CallSessionStore.ActiveCalls.FirstOrDefault(c => c.Id == CallId);

        var isCreator = activeCall is { } call
            && ProfileStore.Profile is { } profile
            && call.CreatedBy.Id == profile.Id;

        var canEndAsRole = BoardDetailsStore.Board is { } board
            && board.Id == BoardId
            && BoardRolePermissions.CanEndCall(board.UserRole);

        _canEndCall = isCreator || canEndAsRole;
        _currentPresenterUserId = activeCall?.CurrentPresenterUserId;

        var environment = await CallsInteropService.CheckEnvironmentAsync();

        if (!environment.IsSupported)
        {
            _isJoining = false;
            _joinError = environment.Reason ?? "This browser doesn't support video calls.";
            return;
        }

        var joinInfo = await CallSessionStore.JoinCallAsync(CallId);

        if (joinInfo is null)
        {
            _isJoining = false;
            _joinError = CallSessionStore.ErrorMessage ?? "Could not join the call.";
            return;
        }

        _selfRef = DotNetObjectReference.Create(this);
        await CallsInteropService.JoinRoomAsync(joinInfo.Token, joinInfo.AcsRoomId, _selfRef);
        _micOn = CallsInteropService.PreJoin.MicEnabled;
        _isJoining = false;

        await RefreshParticipantsAsync();
        await LoadLinkedTasksAsync();
    }

    [JSInvokable]
    public Task OnTileAdded(string tileId, bool isLocal, bool hasVideo)
    {
        if (_tiles.Any(t => t.TileId == tileId))
            return Task.CompletedTask;

        _tiles.Add(new CallTile(tileId, isLocal, hasVideo));

        if (isLocal)
            _cameraOn = hasVideo;

        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnTileRemoved(string tileId)
    {
        _tiles.RemoveAll(t => t.TileId == tileId);

        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnTileVideoStateChanged(string tileId, bool hasVideo)
    {
        var index = _tiles.FindIndex(t => t.TileId == tileId);

        if (index < 0)
            return Task.CompletedTask;

        _tiles[index] = _tiles[index] with { HasVideo = hasVideo };

        return InvokeAsync(StateHasChanged);
    }

    private (string? DisplayName, string? Email, string? ProfilePhotoUrl) GetTileIdentity(CallTile tile)
    {
        // The local tile is resolved from the profile store directly rather than the participants
        // roster: that roster is populated by Story 1.2's Event-Grid pipeline, which can lag a moment
        // behind the local ACS SDK connection actually completing -- the local user's own identity is
        // always known instantly and shouldn't wait on that round-trip.
        if (tile.IsLocal)
        {
            var profile = ProfileStore.Profile;
            return (profile?.DisplayName, profile?.Email, profile?.ProfilePhotoUrl);
        }

        return _participantsByAcsId.TryGetValue(tile.TileId, out var participant)
            ? (participant.DisplayName, participant.Email, participant.ProfilePhotoUrl)
            : (null, null, null);
    }

    private async Task RefreshParticipantsAsync()
    {
        try
        {
            var participants = await CallsApiService.GetParticipantsAsync(CallId);
            _participantsByAcsId = participants.ToDictionary(p => p.AcsCommunicationUserId, p => p);
        }
        catch (ApiServiceException)
        {
            // Best-effort: this only resolves display name/email/avatar for remote tiles, which
            // already render fine (just unlabeled) without it.
            return;
        }

        StateHasChanged();
    }

    private async Task LoadLinkedTasksAsync()
    {
        _isLoadingLinkedTasks = true;
        StateHasChanged();

        try
        {
            _linkedTasks = await CallsApiService.GetLinkedTasksAsync(CallId);
        }
        catch (ApiServiceException)
        {
            // Best-effort: the meet board just shows an empty list if this fails: no linked
            // tasks is already a valid state, so there's nothing further to surface here.
        }
        finally
        {
            _isLoadingLinkedTasks = false;
            StateHasChanged();
        }
    }

    // Mirrors the live-sync patch path (below): an edit made from this page's own linked-task
    // accordion is applied the same way an incoming BoardChanged event for it would be, so both
    // paths stay consistent and the eventual SignalR echo of our own save is a harmless no-op.
    private void OnLinkedTaskChanged(BoardTaskDetailsDto updatedTask)
    {
        if (UpdateLinkedTask(updatedTask.Id, _ => updatedTask))
            StateHasChanged();
    }

    private void OnBoardActionReceived(BoardActionNotification notification)
    {
        if (notification.BoardId != BoardId)
            return;

        InvokeAsync(() => ApplyLinkedTaskChange(notification));
    }

    // Board-task changes made elsewhere (the board page, or another call participant once the
    // call page can edit tasks too) are applied straight from the pushed payload -- every field a
    // linked-task card shows (title, column, assignee, description, attachments) is carried on the
    // wire, so this never needs a follow-up API call.
    private void ApplyLinkedTaskChange(BoardActionNotification notification)
    {
        var applied = notification.Payload switch
        {
            TaskUpdatedPayload payload =>
                UpdateLinkedTask(payload.BoardTaskId, task => task with { Title = payload.Title }),

            TaskDescriptionChangedPayload payload =>
                UpdateLinkedTask(payload.BoardTaskId, task => task with { Description = payload.Description }),

            TaskAssigneeChangedPayload payload =>
                UpdateLinkedTask(payload.BoardTaskId, task => task with { Assignee = payload.Assignee }),

            // Every other case here is a plain field overwrite -- reapplying the same value is
            // naturally a no-op, which is what makes the echo of our own edit (Story 4.2) safe to
            // ignore without a sync guard. Append is not naturally idempotent the same way: the
            // actor's own optimistic append (CallMeetBoardLinkedTaskItem.OpenAddAttachmentDialogAsync)
            // plus this same event echoing back would otherwise double the attachment for them
            // specifically -- guarded explicitly here instead.
            TaskAttachmentAddedPayload payload =>
                UpdateLinkedTask(payload.BoardTaskId, task => task.Attachments.Any(a => a.Id == payload.Attachment.Id)
                    ? task
                    : task with { Attachments = task.Attachments.Append(payload.Attachment).ToList() }),

            TaskAttachmentRemovedPayload payload =>
                UpdateLinkedTask(payload.BoardTaskId, task => task with
                {
                    Attachments = task.Attachments.Where(a => a.Id != payload.AttachmentId).ToList(),
                }),

            TasksReorderedPayload payload =>
                UpdateLinkedTask(payload.BoardTaskId, task => task with
                {
                    ColumnId = payload.TargetColumnId,
                    ColumnName = ResolveColumnName(payload.TargetColumnId) ?? task.ColumnName,
                    Position = payload.Position,
                }),

            TaskCompletionChangedPayload payload =>
                UpdateLinkedTask(payload.BoardTaskId, task => task with
                {
                    IsDone = payload.IsDone,
                    CompletedAtUtc = payload.CompletedAtUtc,
                }),

            TaskStoryPointsChangedPayload payload =>
                UpdateLinkedTask(payload.BoardTaskId, task => task with { StoryPoints = payload.StoryPoints }),

            TaskTimeboxChangedPayload payload =>
                UpdateLinkedTask(payload.BoardTaskId, task => task with { TimeboxHours = payload.TimeboxHours }),

            TaskDeletedPayload payload => RemoveLinkedTask(payload.BoardTaskId),

            _ => false,
        };

        if (applied)
            StateHasChanged();
    }

    private bool UpdateLinkedTask(Guid taskId, Func<BoardTaskDetailsDto, BoardTaskDetailsDto> update)
    {
        if (_linkedTasks.All(task => task.Id != taskId))
            return false;

        _linkedTasks = _linkedTasks.Select(task => task.Id == taskId ? update(task) : task).ToList();
        return true;
    }

    private bool RemoveLinkedTask(Guid taskId)
    {
        if (_linkedTasks.All(task => task.Id != taskId))
            return false;

        _linkedTasks = _linkedTasks.Where(task => task.Id != taskId).ToList();
        return true;
    }

    // TasksReordered only carries the target column's id, not its name (AD-2/AD-10: SignalR
    // relays board state, not a lookup service) -- resolved locally against the board's own
    // column list, already loaded by this page (see OnInitializedAsync) rather than fetched again.
    private string? ResolveColumnName(Guid columnId) =>
        BoardDetailsStore.Board?.Columns.FirstOrDefault(column => column.Id == columnId)?.Name;

    private string GetCallTitle() =>
        CallSessionStore.ActiveCalls.FirstOrDefault(c => c.Id == CallId)?.Title ?? string.Empty;

    private string? GetCallTopic() =>
        CallSessionStore.ActiveCalls.FirstOrDefault(c => c.Id == CallId)?.Topic;

    private void ToggleMeetBoard() =>
        _isMeetBoardOpen = !_isMeetBoardOpen;

    private void CloseMeetBoard() =>
        _isMeetBoardOpen = false;

    private void OnCallParticipantsChanged(Guid callSessionId)
    {
        if (callSessionId != CallId)
            return;

        InvokeAsync(RefreshParticipantsAsync);
    }

    private void OnCallPresenterChanged(Guid callSessionId, Guid? presenterUserId)
    {
        if (callSessionId != CallId)
            return;

        _currentPresenterUserId = presenterUserId;
        InvokeAsync(StateHasChanged);
    }

    private void OnCallSessionClosed(Guid callSessionId)
    {
        if (callSessionId != CallId)
            return;

        InvokeAsync(async () =>
        {
            await EndLocalConnectionAsync();
            Snackbar.Add("This call has ended.", Severity.Info);
            GoBackToBoard();
        });
    }

    /// <summary>
    /// Fires when calls.js observes the local ACS call go Disconnected -- the only signal a
    /// participant forcibly removed via a force-end (AD-15) gets on their own client, since that
    /// removal doesn't round-trip through our SignalR SessionClosed notification for them.
    /// _hasLeft already true here means this is our own voluntary hangUp() completing, not a
    /// forced one -- no-op to avoid double-navigating.
    /// </summary>
    [JSInvokable]
    public Task OnCallDisconnected()
    {
        if (_hasLeft)
            return Task.CompletedTask;

        _hasLeft = true;

        return InvokeAsync(() =>
        {
            Snackbar.Add("This call has ended.", Severity.Info);
            GoBackToBoard();
        });
    }

    /// <summary>
    /// Fires when calls.js observes the local screen share stop through a means other than our
    /// own ToggleScreenShareAsync (e.g. the browser's native "Stop sharing" control). Releases the
    /// presenter lock (AD-9) so it doesn't stay stuck server-side once the share has already ended.
    /// No-ops if we're not the presenter -- either ToggleScreenShareAsync already released it, or
    /// we never held it.
    /// </summary>
    [JSInvokable]
    public Task OnLocalScreenShareStopped()
    {
        if (!IsLocalUserPresenting)
            return Task.CompletedTask;

        return InvokeAsync(async () =>
        {
            await CallSessionStore.StopScreenShareAsync();
            _currentPresenterUserId = null;
            StateHasChanged();
        });
    }

    private async Task OnTileElementReadyAsync((string TileId, ElementReference Element) args) =>
        await CallsInteropService.RegisterTileElementAsync(args.TileId, args.Element);

    private Task OnStageElementReadyAsync(ElementReference element) =>
        CallsInteropService.RegisterStageElementAsync(element);

    private string GetScreenShareTitle()
    {
        if (IsLocalUserPresenting)
            return "Stop sharing";

        return _currentPresenterUserId.HasValue
            ? "Someone else is presenting"
            : "Share screen";
    }

    private async Task ToggleScreenShareAsync()
    {
        if (IsLocalUserPresenting)
        {
            var released = await CallSessionStore.StopScreenShareAsync();

            if (!released)
                return;

            _currentPresenterUserId = null;
            await CallsInteropService.StopScreenShareAsync();

            return;
        }

        if (_currentPresenterUserId.HasValue)
            return;

        var granted = await CallSessionStore.RequestScreenShareAsync();

        if (!granted)
        {
            Snackbar.Add(CallSessionStore.ErrorMessage ?? "Someone else is presenting.", Severity.Warning);
            return;
        }

        try
        {
            await CallsInteropService.StartScreenShareAsync();
            _currentPresenterUserId = ProfileStore.Profile?.Id;
        }
        catch (Exception)
        {
            // The server granted the lock but the local share never actually started (e.g. the
            // browser's screen picker was cancelled) -- release it so it doesn't get stuck (Epic 2).
            await CallSessionStore.StopScreenShareAsync();
            Snackbar.Add("Could not start screen sharing.", Severity.Error);
        }
    }

    private async Task ToggleMicAsync() =>
        _micOn = await CallsInteropService.ToggleMicAsync();

    private async Task ToggleCameraAsync()
    {
        _cameraOn = await CallsInteropService.ToggleCameraAsync();

        var index = _tiles.FindIndex(t => t.IsLocal);

        if (index >= 0)
            _tiles[index] = _tiles[index] with { HasVideo = _cameraOn };
    }

    private async Task LeaveAsync()
    {
        await EndLocalConnectionAsync();
        CallSessionStore.LeaveCurrentCall();
        GoBackToBoard();
    }

    private async Task EndCallAsync()
    {
        await EndLocalConnectionAsync();
        await CallSessionStore.EndCurrentCallAsync();
        GoBackToBoard();
    }

    private async Task EndLocalConnectionAsync()
    {
        if (_hasLeft)
            return;

        _hasLeft = true;
        await CallsInteropService.HangUpAsync();
    }

    private void GoBackToBoard() => Navigation.NavigateTo($"/boards/{BoardId}");

    public async ValueTask DisposeAsync()
    {
        CallSessionStore.CallSessionClosed -= OnCallSessionClosed;
        CallSessionStore.CallParticipantsChanged -= OnCallParticipantsChanged;
        CallSessionStore.CallPresenterChanged -= OnCallPresenterChanged;
        ActionsHubService.BoardActionReceived -= OnBoardActionReceived;

        await EndLocalConnectionAsync();
        _selfRef?.Dispose();

        if (_joinedBoardGroup)
            await ActionsHubService.LeaveBoardAsync(BoardId);
    }
}
