{
  "AllowedHosts": "*",

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "JustTaskTracker.Application.Common.Behaviors.MediatrPipelineLogging": "Warning"
      }
    },

    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [CorrelationId: {CorrelationId:l}] {Message:lj} {NewLine}{Exception}"
        }
      }
    ]
  },

  "Billing": {
    "Plans": {
      "free": {
        "Id": "free",
        "DisplayName": "Free",
        "Features": [],
        "Limits": {
          "MaxBoards": 3,
          "MaxColumnsPerBoard": 5,
          "MaxTasksPerBoard": 50,
          "MaxMembersPerBoard": 5
        }
      },
      "pro": {
        "Id": "pro",
        "DisplayName": "Pro",
        "PriceId": "price_1TvEsLHQy5xcQlWh7u6pin5v",
        "Features": [
          "board.export",
          "board.reexport",
          "board.archive.download"
        ],
        "Limits": {
          "MaxBoards": null,
          "MaxColumnsPerBoard": null,
          "MaxTasksPerBoard": null,
          "MaxMembersPerBoard": null
        }
      }
    },
    "DefaultPlanId": "free"
  }
}
